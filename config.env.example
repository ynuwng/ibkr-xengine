# Copy to config.env and edit. config.env is git-ignored.

# IB Gateway: 4002 = paper, 4001 = live (TWS desktop: 7497 paper / 7496 live)
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=1

# true = log signals only, never place orders. Set to false to trade.
DRY_RUN=true

SYMBOL=BMNR
EXCHANGE=SMART
CURRENCY=USD

# Strategy
VOL_PERIOD=20
VOL_RATIO_TH=1.45
SHORT_MA=5
MID_MA=10
ATR_PERIOD=14
TP_ATR=2.5
SL_ATR=1.5
RISK_PCT=0.5

# LOG_DIR=/var/log/ibkr-xengine
